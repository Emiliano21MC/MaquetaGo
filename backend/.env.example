PORT=3001
HOST=0.0.0.0
DB_HOST=your-instance.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=replace-with-your-database-password
DB_NAME=maquetago_db
JWT_SECRET=replace-with-at-least-32-random-characters
NODE_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:19006
# La entrega se activa automáticamente al configurar SMTP_USER y SMTP_PASS.
OTP_DELIVERY=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_IDS=
PAYMENT_MODE=local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Servicios de mapas públicos, sustituibles por instancias propias.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org

# Datos REALES del comercio Yape (payload EMV emitido por el proveedor).
YAPE_PHONE=
YAPE_MERCHANT_NAME=
YAPE_EMV_PAYLOAD=

# TLS RDS con CA oficial y validación de identidad del servidor.
DB_SSL=true
DB_SSL_CA_FILE=certs/aws-rds-us-east-1-bundle.pem
DB_INIT_ON_START=true
