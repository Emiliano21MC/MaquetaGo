{
  "name": "maquetago-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/backend/src/server.js",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/init-db.ts",
    "test": "tsx --test test/*.test.ts",
    "smtp:verify": "tsx scripts/verify-smtp.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "google-auth-library": "^10.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.0",
    "nodemailer": "^10.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
